# --- Application
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- Base de données (docker compose : PostgreSQL exposé sur 5433)
DATABASE_URL=postgresql://uniparent_user:CHANGE_ME@localhost:5433/uniparent_afram_db?schema=public

# --- JWT (obligatoires, >= 32 caractères aléatoires)
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# En dev uniquement : renvoie le code OTP dans la réponse API (jamais en production)
OTP_DEV_ECHO=false

# --- Reçus : secret de signature des QR codes de vérification
RECEIPT_SIGNING_SECRET=CHANGE_ME

# --- Stockage fichiers (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uniparent
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Paiements (SANDBOX | CINETPAY | STRIPE)
PAYMENT_DEFAULT_PROVIDER=SANDBOX
SANDBOX_WEBHOOK_SECRET=CHANGE_ME
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications push (Firebase Admin, JSON du compte de service encodé en base64)
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Limitation de débit des routes d’authentification (req/min/IP)
AUTH_RATE_LIMIT=5
