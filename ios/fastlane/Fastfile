default_platform(:ios)

platform :ios do
  desc "Envoie l'IPA sur TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(is_key_content_base64: true, key_content: ENV["APP_STORE_CONNECT_API_KEY_JSON"])
    upload_to_testflight(api_key: api_key, ipa: "../build/ios/ipa/uniparent.ipa", skip_waiting_for_build_processing: true)
  end
end
